# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── Node / Next.js ─────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# ─── Environment / Secrets ───────────────────────────────────────────────────
.env
.env.*
!env-template-backend.txt

# ─── Python ──────────────────────────────────────────────────────────────────
# Virtual environments
venv/
.venv/
env/
ENV/

# Byte-compiled / optimised / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg
MANIFEST

# ─── Database ────────────────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal

# ─── Benchmark results (generated artefacts) ────────────────────────────────
data/benchmarks/results_*.json

# ─── Temporary execution sandbox ─────────────────────────────────────────────
/temp_run/

# ─── Task artifacts (generated per-run) ──────────────────────────────────────
/tasks/

# ─── Internal / draft docs (not for public repo) ─────────────────────────────
AGENTS.md
new_README.md
PROJECT_CONTEXT.md
LANGGRAPH_MIGRATION_PLAN.md
MIGRATION_COMPLETE.md
events_log_latest.txt
.gitignore
